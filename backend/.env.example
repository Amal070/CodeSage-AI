# ==============================================================================
# CodeSage AI — Backend Environment Configuration Template
# Copy this file to .env and adjust values for your local environment
# ==============================================================================

# Application
PROJECT_NAME="CodeSage AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/codesage_db

# JWT Security
# Generate a strong secret key for production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload & Storage Limits
MAX_UPLOAD_SIZE_MB=100
MAX_VIEWABLE_FILE_SIZE_MB=5
STORAGE_DIR=storage

# Embedding Model (SentenceTransformers / HuggingFace)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto
EMBEDDING_NORMALIZE=true

# FAISS Semantic Search
INDEXES_DIR=storage/indexes
DEFAULT_SEARCH_TOP_K=5
MAX_SEARCH_TOP_K=20

# Local AI / Ollama LLM Runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
MAX_PROMPT_LENGTH=10000

# LangChain & RAG Pipeline
DEFAULT_RAG_TOP_K=5
MAX_RAG_TOP_K=10
MAX_RAG_QUESTION_LENGTH=5000
MAX_CONTEXT_CHARACTERS=12000

# Conversation History & Chat (Day 16)
CHAT_HISTORY_LIMIT=10
CHAT_MAX_CONTEXT_LENGTH=12000
CHAT_MAX_HISTORY_LENGTH=4000

# Context Retrieval (Day 17)
RETRIEVAL_CANDIDATE_CHUNKS=30
RETRIEVAL_TOP_FILES=5
RETRIEVAL_MAX_TOP_FILES=10
RETRIEVAL_CHUNKS_PER_FILE=3
RETRIEVAL_MIN_SIMILARITY_THRESHOLD=0.20
